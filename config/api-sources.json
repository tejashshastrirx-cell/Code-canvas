    { "name": "Khronos glTF-Sample-Assets", "api": "https://raw.githubusercontent.com/KhronosGroup/glTF-Sample-Assets/main/Models/{name}/metadata.json", "auth": "none", "license": "per model (CC0 / CC-BY-4.0 / some NC — script filters)", "status": "working" },
    { "name": "Sketchfab", "api": "https://api.sketchfab.com/v3/search?type=models&downloadable=true&license=cc0|by", "auth": "search: none; download: personal API token (SKETCHFAB_API_TOKEN)", "license": "filtered to CC0 / CC-BY", "status": "search working; download not automated" },
    { "name": "Fontsource (Google Fonts mirror)", "api": "https://cdn.jsdelivr.net/npm/@fontsource-variable/{family}@5.1.0/files/", "auth": "none", "license": "OFL-1.1", "status": "working" },
    { "name": "Lucide static", "api": "https://cdn.jsdelivr.net/npm/lucide-static@0.460.0/icons/{name}.svg", "auth": "none", "license": "ISC", "status": "working (also bundled via lucide-react)" },
    { "name": "Kenney", "api": null, "auth": "none", "license": "CC0", "status": "403 to automated fetch — manual browser download only" }
